{
	"$schema": "https://cdn.statically.io/gh/nguyenngoclongdev/cdn/main/schema/v11/terminal-keeper.json",
	"theme": "tribe",
	"active": "default",
	"activateOnStartup": true,
	"keepExistingTerminals": false,
	"sessions": {
		"default": [
			{
				"name": "prebid test server",
				"autoExecuteCommands": true,
				"icon": "rocket",
				"color": "terminal.ansiGreen",
				"commands": [
					"npx gulp serve-e2e-dev --modules=adtelligentBidAdapter,bidmaticBidAdapter,obozhkoBidAdapter"
				]
			},
			{
				"name": "npm run dev",
				"autoExecuteCommands": true,
				"icon": "circle-filled",
				"color": "terminal.ansiGreen",
				"commands": ["npm run dev"]
			},
			{
				"name": "docker-compose:mongo",
				"autoExecuteCommands": true,
				"icon": "cloud",
				"color": "terminal.ansiGreen",
				"commands": ["docker-compose up -d mongo"]
			},
			[
				{
					"name": "docker:ros",
					"commands": [""]
				},
				{
					"name": "docker:k8s",
					"commands": [""]
				}
			],
			[
				{
					"name": "docker:nats",
					"commands": [""]
				},
				{
					"name": "docker:fleet",
					"commands": [""]
				}
			]
		],
		"saved-session": [
			{
				"name": "connect",
				"commands": [""]
			}
		]
	}
}
